{
  "name": "nimbo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A detailed weather app: forecasts, air quality, sun and moon, climate history and radar for any place.",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "build": "tsc --noEmit && vite build",
    "preview": "npm run build && wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@tanstack/react-query": "^5.106.1",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "lucide-react": "^1.69.0",
    "maplibre-gl": "^6.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "suncalc": "^2.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
